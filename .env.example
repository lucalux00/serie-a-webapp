# API-Football: calendario/quote reali. Il piano deve includere la stagione corrente.
# Usa RAPIDAPI_KEY per RapidAPI oppure API_FOOTBALL_KEY per il dashboard API-Sports.
RAPIDAPI_KEY=inserisci_qui_la_tua_chiave
API_FOOTBALL_KEY=

# Fantacalcio: calendario/classifica e statistiche individuali.
# Non esporre queste chiavi con il prefisso NEXT_PUBLIC_.
FOOTBALL_DATA_API_KEY=
BBS_API_KEY=

# Ingestion RSS e classificazione Smart Aggregator
GEMINI_API_KEY=
CRON_SECRET=usa_un_segreto_lungo_e_casuale

# Public site and monetization configuration. Enable analytics only after CMP consent is configured.
NEXT_PUBLIC_SITE_URL=https://tatticaepronostici.it
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_CMP_SCRIPT_SRC=
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT=1234567890
NEXT_PUBLIC_CONTACT_EMAIL=contatti@tatticaepronostici.it
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@tatticaepronostici.it
NEXT_PUBLIC_LEGAL_ENTITY=Tattica & Pronostici

# Stripe Billing (server-side; non usare NEXT_PUBLIC_ per le chiavi segrete)
STRIPE_SECRET_KEY=sk_test_inserisci_la_chiave
STRIPE_WEBHOOK_SECRET=whsec_inserisci_il_segreto_webhook
STRIPE_PRO_PRICE_ID=price_inserisci_il_piano_mensile
